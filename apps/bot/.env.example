# Copy to .env and fill in. Never commit .env. Values below are placeholders.

# Required
SLACK_BOT_TOKEN=xoxb-replace-me
# The 32-character signing secret from the Slack app (Basic Information). Required: the bot refuses to start without it, and refuses a
# value shorter than 32 characters or one starting with "replace-".
SLACK_SIGNING_SECRET=
SITE_BASE_URL=https://loadout.example
SERVICE_KEY_SLACK_BOT=replace-with-at-least-32-characters-of-random-text

# Names and triggers
BOT_NAME=Rig
BOT_TRIGGER_WORDS=rig

# Feature switches: an empty id turns that feature off
HELP_CHANNEL_ID=
COMMUNITY_CHANNEL_ID=
LOG_CHANNEL_ID=
ORPHAN_BOT_ID=
ORPHAN_REPLY=thx orphan
# Slack admins (comma separated member ids). Must equal BOT_ADMIN_SLACK_IDS in the site's environment: the site checks helper changes
# against that list, so two different lists let a demoted admin keep helper power, and an empty site list refuses every admin.
ADMIN_SLACK_IDS=

# Desk reaction names (Slack emoji names, no colons)
DESK_EMOJI_OPEN=eyes
DESK_EMOJI_RESOLVED=white_check_mark

# Optional AI replies (off by default)
ANTHROPIC_API_KEY=
CHAT_ENABLED=false
CHAT_CHIME=false

# Server and logs
PORT=3000
LOG_LEVEL=info

# Local development only: use the in-memory site instead of the real one
BOT_FAKE_SITE=0
