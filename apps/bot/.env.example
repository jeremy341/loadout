# Copy to .env and fill in. Never commit .env. Values below are placeholders.

# Required
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-with-signing-secret
SITE_BASE_URL=https://loadout.example
SERVICE_KEY_SLACK_BOT=replace-with-at-least-32-characters-of-random-text

# Names and triggers
BOT_NAME=Rig
BOT_TRIGGER_WORDS=rig

# Feature switches: an empty id turns that feature off
HELP_CHANNEL_ID=
COMMUNITY_CHANNEL_ID=
LOG_CHANNEL_ID=
ORPHAN_BOT_ID=
ORPHAN_REPLY=thx orphan
ADMIN_SLACK_IDS=

# Desk reaction names (Slack emoji names, no colons)
DESK_EMOJI_OPEN=eyes
DESK_EMOJI_RESOLVED=white_check_mark

# Optional AI replies (off by default)
ANTHROPIC_API_KEY=
CHAT_ENABLED=false
CHAT_CHIME=false

# Server and logs
PORT=3000
LOG_LEVEL=info

# Local development only: use the in-memory site instead of the real one
BOT_FAKE_SITE=0
