NEXT_PUBLIC_LOADOUT_SITE_URL=
NEXT_PUBLIC_LOADOUT_JOIN_URL=https://rsvp.soon.it/loadout
NEXT_PUBLIC_LOADOUT_LOGIN_URL=
NEXT_PUBLIC_LOADOUT_COMMUNITY_URL=
LOADOUT_ALLOW_INDEXING=false

# Reverse proxy trust. Rate limits and audit throttles key on the caller's address, and x-forwarded-for / x-real-ip are only
# believed when this is "true" (Vercel sets VERCEL itself, which counts too). Set it ONLY when a proxy you control sits in front
# and appends the client address as the last x-forwarded-for hop. Unset (the default), every caller shares one "unknown" bucket per
# instance, so a client can never rotate a header to dodge a limit.
LOADOUT_TRUST_PROXY=
# The one real address of the reviewer site (for example review.example.com; comma separate several). When set, only those hosts
# are the reviewer site and the "first label is review" rule is off, so a forged Host header cannot reach it. Unset: any review.<domain>.
LOADOUT_REVIEW_HOST=

# Optional shared admin password for the whole platform. When set, every participant page and every page on the review host
# redirects to /dashboard/sign-in until this password is entered; the homepage and public Docs stay public. The unlock is an
# HMAC cookie lasting 7 days, then the person signs in with Hack Club Auth. Unset: the gate is off (local development by default).
# All admins use this one value. Never commit the real value; put it only in the deployment's environment settings.
LOADOUT_PLATFORM_PASSWORD=

# Participant platform (M1). Local Postgres from compose.yaml; never a production value.
DATABASE_URL=postgresql://loadout:loadout-local@localhost:5432/loadout_dev
# Local test accounts only, until Hack Club Auth is connected (gate G1). Honoured only when NODE_ENV is development or test (and,
# where the caller passes the request host, only on localhost, *.localhost and private LAN hosts). Ignored everywhere else.
LOADOUT_LOCAL_TEST_ACCOUNTS=true

# Local preview only: which test account the platform opens as without sign-in: builder, owner (or staff), reviewer,
# final-reviewer, hardware-reviewer, helper or fulfiller. Ignored in production.
LOADOUT_PREVIEW_ROLE=builder

# Owners of the reviewer site: a comma-separated list of verified emails. Owners come from here and nowhere else; no database
# row can make one. Reviewers, helpers and fulfillers are role grants (see .ulpi/design/reviewer-roles.md).
LOADOUT_OWNER_EMAILS=

# Hack Club Auth sign-in (gate G1). Create the app at https://auth.hackclub.com and paste its values into .env.local only.
# OAuth client id from the Hack Club Auth app. Empty means sign-in shows "not set up".
HCA_CLIENT_ID=
# OAuth client secret from the same app. Server only; never commit it.
HCA_CLIENT_SECRET=
# Callback registered on the app. Empty uses http://localhost:3010/api/auth/hackclub/callback.
HCA_REDIRECT_URI=
# Slack bot token with the users:read scope. Used at sign-in to copy the builder's Slack picture to their profile. Server only. Empty means no pictures.
SLACK_BOT_TOKEN=

# Journal photos and project covers (lib/platform/uploads.ts). Off unless this is exactly "true". On here for local work.
# Files go to .uploads/ (git ignored). Production needs real storage before this is turned on.
LOADOUT_UPLOADS=true
# The day uploads go live (an ISO date). Entries created on or after it need one photo per 4 hours. Unset: the rule covers no entry.
LOADOUT_PHOTO_RULE_FROM=

# Superadmin bootstrap (reviewer site, /superadmin). Unset or blank: the page answers 404. Set it to a long random value that only
# the people who run the deployment hold, never in the repository. A signed-in reviewer who types it gets the "admin" role grant,
# which opens staff impersonation (it adds no other access and never makes an owner). Every use and every wrong attempt is audited.
LOADOUT_SUPERADMIN_BOOTSTRAP_SECRET=
# Staff impersonation cookie (loadout_impersonation). The reviewer site and the participant dashboard are different hosts, so a
# host-only cookie set on one never reaches the other. Set the shared parent domain (for example ".example.com") for the cookie to
# cross; empty keeps it host-only, which is right when both run on one host. A value that is not a parent of the current host, or
# that is a bare public suffix, is ignored and the cookie stays host-only.
LOADOUT_IMPERSONATION_COOKIE_DOMAIN=
# Session cookies are Secure in production, or in development when this is exactly "true" (for a local HTTPS tunnel).
LOADOUT_SECURE_COOKIES=
# Optional session cookie Domain, for example "example.com". Applied only when the cookie is Secure; otherwise the session
# cookie stays host-only. Do not set a bare public suffix. Production sets it to the parent of the dashboard and reviewer hosts
# (loadout.dino.icu) so one sign-in works on both. The gate unlock cookie uses the same Domain.
SESSION_COOKIE_DOMAIN=

# Fraud and verification automation (lib/platform/fraud/*). Every key is optional; a feature whose keys are unset is off, never an error.
# Bearer for the /api/cron/fraud-robert-sync and /api/cron/fraud-precheck endpoints. Unset: they answer 403.
CRON_SECRET=
# Telescreen (Robert), Hack Club's fraud-review desk. Both keys, or Robert is off. The URL is the API base, for example
# https://telescreen.hackclub.com/api/v1/ysws. Server only; never commit the key.
LOADOUT_TELESCREEN_URL=
LOADOUT_TELESCREEN_KEY=
# Fraudy (human versus AI share of tracked time). Unset: off. The URL defaults to https://fraudy.hackclub.com/api/v1/check-ai.
LOADOUT_FRAUDY_KEY=
LOADOUT_FRAUDY_URL=
# Hack Club Ships archive list for the double-dip check, for example https://ships.hackclub.com/api/v1/ysws_entries.
# Unset: a new ship is compared with LOADOUT's own approved ships only.
LOADOUT_YSWS_ARCHIVE_URL=
# AI pre-check of shipped repos. "off" switches it off. The model key is an OpenRouter key; without it the fixed rules still run.
LOADOUT_PRECHECK=
LOADOUT_PRECHECK_AI_KEY=
LOADOUT_PRECHECK_MODEL=
# GitHub token for the pre-check's repo file listing. Unset: unauthenticated GitHub calls (60 an hour).
LOADOUT_GITHUB_TOKEN=

# Shared secret for the cron endpoints (app/api/cron/[job]); Vercel cron sends it as the bearer. Unset: every scheduled run is refused (403), never run.
CRON_SECRET=

# Airbridge fulfillment preview (optional). Comma-separated LOADOUT project number:Unified record ID pairs.
LOADOUT_AIRBRIDGE_MAPPINGS=
LOADOUT_AIRBRIDGE_PROGRAM=LOADOUT
