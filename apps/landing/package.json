{
  "name": "@loadout/landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns=\"**/hca-actions.test.ts\" app/site-config.test.ts app/docs app/rock-bottom.test.ts app/_components/mole app/_components/display-preferences.test.ts lib/platform lib/reviewer reviewer-dash/lib reviewer-dash/app/_ui && bun test lib/platform/hca-actions.test.ts",
    "capture": "node scripts/capture-homepage.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:local": "bun run scripts/seed-local-accounts.ts",
    "db:seed:community": "bun run scripts/seed-community.ts"
  },
  "dependencies": {
    "@hackclub/icons": "^0.2.2",
    "@number-flow/react": "^0.6.2",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "github-slugger": "^2.0.0",
    "lenis": "^1.3.23",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "motion": "^14.14.0",
    "next": "16.3.5",
    "pg": "^8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.7.0",
    "tldts": "7.4.18",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
