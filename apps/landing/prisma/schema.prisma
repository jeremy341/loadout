// M1 participant platform data. Milestone scope: docs/plans participant-platform-milestones.md.
// Keep this file to the M1 tables; later milestones add their own migrations.

generator client {
  provider   = "prisma-client"
  output     = "../lib/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String
  // Staff-only reason for a ban. Never shown to the banned person.
  bannedAt    DateTime?
  banReason   String?
  createdAt   DateTime   @default(now())
  // Public profile (lib/platform/profile.ts). Lower-case handle, unique; null until the builder picks one.
  handle      String?    @unique
  bio         String?
  roles       RoleGrant[]
  sessions    Session[]
  projects    Project[]
  // Toolbelt: builders this person has blocked from equipping their tools, and people who blocked this person.
  blocksMade     ToolbeltBlock[] @relation("ToolbeltMaker")
  blocksReceived ToolbeltBlock[] @relation("ToolbeltBlocked")
  // Saved projects (lib/platform/bookmarks.ts).
  bookmarks      ProjectBookmark[]
}

model RoleGrant {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      String
  grantedAt DateTime @default(now())

  @@unique([personId, role])
}

model Session {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  // SHA-256 of the cookie value. The raw token is never stored.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([personId])
}

model Project {
  id        String   @id @default(cuid())
  ownerId   String
  owner     Person   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // One of the track names in lib/platform/progress.ts. Null until the builder picks one.
  track       String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  // Public source and demo addresses (https only, checked in lib/platform/profile.ts).
  repoUrl     String?
  demoUrl     String?
  pinned      Boolean  @default(false)
  // Owner hides the project from the public profile and Explore.
  hidden      Boolean  @default(false)
  // Show a logging project as "currently building" on the profile.
  showBuilding Boolean @default(false)
  // Toolbelt: tools this project equips, and projects that equip this one.
  equips      ToolbeltUse[] @relation("ToolbeltEquipper")
  usedBy      ToolbeltUse[] @relation("ToolbeltTool")
  bookmarks   ProjectBookmark[]

  @@index([ownerId])
}

// "Saved": a builder keeps a project they may see. Private to the person who saved it; never listed publicly.
model ProjectBookmark {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([personId, projectId])
  @@index([personId])
  @@index([projectId])
}

// Toolbelt (plans/proposals/toolbelt.md): an equipping project uses another builder's approved open-source project.
// status is "pending" | "confirmed" | "declined". At most two pending or confirmed rows per projectId (enforced in code).
model ToolbeltUse {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation("ToolbeltEquipper", fields: [projectId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Project   @relation("ToolbeltTool", fields: [toolId], references: [id], onDelete: Cascade)
  note      String
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@unique([projectId, toolId])
  @@index([projectId])
  @@index([toolId])
}

// A maker stops a builder from equipping their tools.
model ToolbeltBlock {
  id        String   @id @default(cuid())
  makerId   String
  maker     Person   @relation("ToolbeltMaker", fields: [makerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Person   @relation("ToolbeltBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([makerId, blockedId])
  @@index([blockedId])
}

// Append-only. Rows are never updated or deleted by the app.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model FeatureFlag {
  name        String   @id
  description String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
